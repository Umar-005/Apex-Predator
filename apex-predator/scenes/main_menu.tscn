[sub_resource type="GDScript" id="GDScript_vue75"]
script/source = "extends Control
@onready var username_input: LineEdit = $CenterContainer/VBoxContainer/UsernameContainer/Username
@onready var leaderboard_panel = $LeaderboardPanel
@onready var scores_container = $LeaderboardPanel/VBoxContainer/ScoresContainer
@onready var leaderboard_request = $LeaderboardRequest


func _ready():
	leaderboard_request.request_completed.connect(_on_leaderboard_received)

	leaderboard_request.request(\"https://apex-predator-api-0oo5.onrender.com/leaderboard\")


func _on_leaderboard_received(result, response_code, headers, body):
	if result != HTTPRequest.RESULT_SUCCESS or response_code != 200:
		print(\"Failed to load leaderboard\")
		return

	var data = JSON.parse_string(body.get_string_from_utf8())

	if not data is Array:
		return

	for child in scores_container.get_children():
		child.queue_free()

	for i in range(data.size()):
		var player = data[i]

		var label = Label.new()
		label.text = \"%d. %s - %d points (Level %d)\" % [
			i + 1,
			player[\"username\"],
			player[\"score\"],
			player[\"level\"]
		]

		scores_container.add_child(label)

func _on_start_button_pressed() -> void:
	var username = username_input.text.strip_edges()

	if username.is_empty():
		username_input.placeholder_text = \"Username Required!\"
		username_input.grab_focus()
		return

	Global.username = username

	get_tree().change_scene_to_file(\"res://scenes/main.tscn\")


func _on_leaderboard_button_pressed():
	$CenterContainer.hide()
	leaderboard_panel.show()
	leaderboard_request.request(\"http://localhost:3000/leaderboard\")


func _on_back_button_pressed():
	leaderboard_panel.hide()
	$CenterContainer.show()
"

